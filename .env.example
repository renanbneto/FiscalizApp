# Copie para .env (raiz) e apps/api/.env
POSTGRES_USER=fiscalizapp
POSTGRES_PASSWORD=fiscalizapp
POSTGRES_DB=fiscalizapp
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=fiscalizapp
MINIO_ROOT_PASSWORD=fiscalizapp-dev
