{
  "name": "fiscalizapp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @fiscalizapp/api db:migrate",
    "db:seed": "pnpm --filter @fiscalizapp/api db:seed",
    "db:studio": "pnpm --filter @fiscalizapp/api db:studio"
  },
  "devDependencies": {
    "turbo": "2.11.5",
    "typescript": "5.9.3"
  }
}
